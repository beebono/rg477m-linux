					hysteresis = <2000>;
					type = "passive";
				};
				big_core7_2_fan_low: trip-fan-low {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};
				big_core7_2_fan_high: trip-fan-high {
