/*
 * Anbernic RG477M (MediaTek MT6897 / Dimensity 8300) - first-boot board file.
 *
 * This tree is embedded in the kernel (CONFIG_ARM64_EMBEDDED_DTB). The
 * bootloader is given the stock vendor tree; early boot code takes memory size,
 * the initramfs location and every /reserved-memory region from that tree and
 * then switches to this one. So there is deliberately no /memory node and no
 * copy of the bootloader's reserved regions here.
 *
 * Stage 1 goal: reach an initramfs with the kernel log visible on the panel
 * (bootloader framebuffer) and preserved in ramoops.
 *
 * Stage 2 adds the watchdog, the PMIC bus and USB device mode. There is no
 * clock driver yet: nodes use 26 MHz placeholders and rely on the state the
 * bootloader left behind (clk_ignore_unused).
 */

/dts-v1/;
#include "mt6897.dtsi"

/ {
	model = "Anbernic RG477M";
	compatible = "anbernic,rg477m", "mediatek,mt6897";

	/*
	 * The bootloader leaves the hardware watchdog armed (about 28 s). The
	 * driver takes it over and the core keeps it fed for
	 * watchdog.open_timeout seconds; after that userspace must hold
	 * /dev/watchdog open, so a boot that never reaches a working init is
	 * still reset and falls back to the other slot.
	 */
	chosen {
		bootargs = "console=tty0 ignore_loglevel printk.devkmsg=on clk_ignore_unused pd_ignore_unused panic=5 watchdog.open_timeout=45";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * Same region and zone layout as the vendor kernel (which gets it from
		 * ramoops.* parameters with 4 KiB record and ftrace zones), so the log
		 * written here is readable as /sys/fs/pstore/console-ramoops-0 after the
		 * device has fallen back to Android. The bootloader marks this region
		 * no-map; that is carried over by the early import.
		 */
		ramoops@48090000 {
			compatible = "ramoops";
			reg = <0x0 0x48090000 0x0 0xe0000>;
			record-size = <0x1000>;
			console-size = <0x40000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x80000>;
		};
	};

	/*
	 * Scan-out buffer left running by the bootloader (its mblock "framebuffer":
	 * 0xff1ef000, 0xe10000 bytes = 3 x 1280x960x4). The region itself is taken
	 * from the bootloader tree and kept out of the linear map by the early
	 * import. The address was read on a 12 GB unit; if another RAM size places
	 * it elsewhere, read it from the bootloader tree instead of fixing it here.
	 */
	framebuffer@ff1ef000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0xff1ef000 0x0 0xe10000>;
		width = <1280>;
		height = <960>;
		stride = <5120>;
		format = "a8r8g8b8";
	};
};

/* Nothing below is needed to reach an initramfs; enable one at a time later. */
&gpu {
	status = "disabled";
};

&gpueb {
	status = "disabled";
};

&keypad {
	status = "disabled";
};

&mfgcfg {
	status = "disabled";
};

&scpsys {
	status = "disabled";
};

&watchdog {
	status = "okay";
};

&soc {
	/*
	 * The bootloader reads its boot mode from the low nibble of the
	 * watchdog's non-reset register 2 (0x1c00a024), same as the vendor
	 * tree's reboot-mode node. "reboot bootloader" lands in fastboot, where
	 * the host can switch the active slot back without waiting for the
	 * retry counter to run out. Kept as its own syscon so the watchdog
	 * driver can own the main register block.
	 */
	syscon@1c00a024 {
		compatible = "syscon", "simple-mfd";
		reg = <0x0 0x1c00a024 0x0 0x4>;

		reboot-mode {
			compatible = "syscon-reboot-mode";
			offset = <0x0>;
			mask = <0xf>;
			mode-charger = <0x1>;
			mode-recovery = <0x2>;
			mode-bootloader = <0x3>;
		};
	};
};

/*
 * PMIC bus. The interrupt line is a pinctrl EINT and there is no pinctrl
 * driver yet, so it is dropped; the bus driver then runs without interrupts.
 * Only VUSB is described, with the vendor tree's limits and always-on, so
 * nothing changes any rail's state or voltage.
 */
&spmi {
	/delete-property/ interrupts-extended;
	/delete-property/ interrupt-names;
	status = "okay";

	mt6368: pmic@5 {
		compatible = "mediatek,mt6368";
		reg = <5 0>;
		interrupt-controller;
		#interrupt-cells = <2>;

		regulators {
			compatible = "mediatek,mt6368-regulator";

			mt6368_vusb: VUSB {
				regulator-compatible = "VUSB";
				regulator-name = "mt6368_vusb";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3500000>;
				regulator-enable-ramp-delay = <680>;
				regulator-always-on;
			};
		};
	};
};

&mt6363 {
	/delete-node/ mt6363keys;
};

/* USB device mode only; no Type-C role detection yet. */
&u2phy0 {
	status = "okay";
};

&ssusb {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	mediatek,force-vbus;
	phys = <&u2port0 PHY_TYPE_USB2>;
	vusb33-supply = <&mt6368_vusb>;
	status = "okay";
};

/*
 * Pin controller. Register block names and order, and the EINT block with its
 * number -> (instance, index, debounce) table, are the stock tree's.
 */
&soc {
	apirq: apirq@11ce0000 {
		compatible = "mediatek,mt6983-eint";
		reg = <0x0 0x11ce0000 0x0 0x1000>,
		      <0x0 0x11de0000 0x0 0x1000>,
		      <0x0 0x11e90000 0x0 0x1000>,
		      <0x0 0x11fe0000 0x0 0x1000>,
		      <0x0 0x1c01e000 0x0 0x1000>;
		reg-names = "eint-e", "eint-s", "eint-w", "eint-n", "eint-c";
		interrupts = <GIC_SPI 309 IRQ_TYPE_LEVEL_HIGH 0>;
		mediatek,instance-num = <5>;
		mediatek,total-pin-number = <250>;
		mediatek,pins = <
			0x00 0x03 0x00 0x01 0x01 0x03 0x01 0x01 0x02 0x03 0x02 0x01 0x03 0x03 0x03 0x01
			0x04 0x00 0x00 0x01 0x05 0x00 0x01 0x01 0x06 0x00 0x02 0x01 0x07 0x03 0x04 0x01
			0x08 0x02 0x00 0x01 0x09 0x03 0x05 0x01 0x0a 0x03 0x06 0x01 0x0b 0x03 0x07 0x01
			0x0c 0x03 0x08 0x01 0x0d 0x03 0x09 0x01 0x0e 0x03 0x0a 0x01 0x0f 0x01 0x00 0x01
			0x10 0x01 0x01 0x01 0x11 0x01 0x02 0x01 0x12 0x01 0x03 0x01 0x13 0x01 0x04 0x01
			0x14 0x01 0x05 0x01 0x15 0x01 0x06 0x01 0x16 0x01 0x07 0x01 0x17 0x01 0x08 0x01
			0x18 0x01 0x09 0x01 0x19 0x01 0x0a 0x01 0x1a 0x01 0x0b 0x01 0x1b 0x01 0x0c 0x01
			0x1c 0x01 0x0d 0x01 0x1d 0x01 0x0e 0x01 0x1e 0x01 0x0f 0x01 0x1f 0x02 0x01 0x01
			0x20 0x02 0x02 0x01 0x21 0x02 0x03 0x01 0x22 0x02 0x04 0x01 0x23 0x02 0x05 0x00
			0x24 0x01 0x10 0x00 0x25 0x01 0x11 0x00 0x26 0x01 0x12 0x00 0x27 0x01 0x13 0x00
			0x28 0x03 0x0b 0x00 0x29 0x03 0x0c 0x00 0x2a 0x03 0x0d 0x00 0x2b 0x03 0x0e 0x00
			0x2c 0x00 0x03 0x00 0x2d 0x00 0x04 0x00 0x2e 0x00 0x05 0x00 0x2f 0x00 0x06 0x00
			0x30 0x00 0x07 0x00 0x31 0x00 0x08 0x00 0x32 0x02 0x06 0x00 0x33 0x02 0x07 0x00
			0x34 0x02 0x08 0x00 0x35 0x02 0x09 0x00 0x36 0x03 0x0f 0x00 0x37 0x03 0x10 0x00
			0x38 0x03 0x11 0x00 0x39 0x03 0x12 0x00 0x3a 0x03 0x13 0x00 0x3b 0x03 0x14 0x00
			0x3c 0x03 0x15 0x00 0x3d 0x03 0x16 0x00 0x3e 0x00 0x09 0x00 0x3f 0x00 0x0a 0x00
			0x40 0x00 0x0b 0x00 0x41 0x00 0x0c 0x00 0x42 0x02 0x0a 0x00 0x43 0x02 0x0b 0x00
			0x44 0x02 0x0c 0x00 0x45 0x02 0x0d 0x00 0x46 0x02 0x0e 0x00 0x47 0x02 0x0f 0x00
			0x48 0x02 0x10 0x00 0x49 0x02 0x11 0x00 0x4a 0x02 0x12 0x00 0x4b 0x02 0x13 0x00
			0x4c 0x02 0x14 0x00 0x4d 0x02 0x15 0x00 0x4e 0x00 0x0d 0x00 0x4f 0x00 0x0e 0x00
			0x50 0x00 0x0f 0x00 0x51 0x00 0x10 0x00 0x52 0x00 0x11 0x00 0x53 0x00 0x12 0x00
			0x54 0x01 0x14 0x00 0x55 0x01 0x15 0x00 0x56 0x01 0x16 0x00 0x57 0x01 0x17 0x00
			0x58 0x01 0x18 0x00 0x59 0x01 0x19 0x00 0x5a 0x01 0x1a 0x00 0x5b 0x01 0x1b 0x00
			0x5c 0x01 0x1c 0x00 0x5d 0x01 0x1d 0x00 0x5e 0x01 0x1e 0x00 0x5f 0x01 0x1f 0x00
			0x60 0x01 0x20 0x00 0x61 0x01 0x21 0x00 0x62 0x01 0x22 0x00 0x63 0x01 0x23 0x00
			0x64 0x01 0x24 0x00 0x65 0x01 0x25 0x00 0x66 0x01 0x26 0x00 0x67 0x01 0x27 0x00
			0x68 0x01 0x28 0x00 0x69 0x01 0x29 0x00 0x6a 0x01 0x2a 0x00 0x6b 0x01 0x2b 0x00
			0x6c 0x01 0x2c 0x00 0x6d 0x01 0x2d 0x00 0x6e 0x01 0x2e 0x00 0x6f 0x01 0x2f 0x00
			0x70 0x01 0x30 0x00 0x71 0x01 0x31 0x00 0x72 0x01 0x32 0x00 0x73 0x00 0x13 0x00
			0x74 0x00 0x14 0x00 0x75 0x00 0x15 0x00 0x76 0x01 0x33 0x00 0x77 0x00 0x16 0x00
			0x78 0x00 0x17 0x00 0x79 0x00 0x18 0x00 0x7a 0x01 0x34 0x00 0xe8 0x04 0x00 0x00
			0xe9 0x04 0x01 0x00 0xea 0x04 0x02 0x00 0xeb 0x04 0x03 0x00 0xec 0x04 0x04 0x00
			0xed 0x04 0x05 0x00 0xee 0x04 0x06 0x00 0xef 0x04 0x07 0x00 0xf0 0x04 0x08 0x00
			0xf1 0x04 0x09 0x00 0xf2 0x04 0x0a 0x00 0xf3 0x04 0x0b 0x00 0xf4 0x04 0x0c 0x00
			0xf5 0x04 0x0d 0x00 0xf6 0x04 0x0e 0x00 0xf7 0x04 0x0f 0x00 0xf8 0x04 0x10 0x00
			0xf9 0x04 0x11 0x00>;
	};
};

&pio {
	reg-names = "gpio", "iocfg_rt", "iocfg_rm", "iocfg_bl", "iocfg_bm",
		    "iocfg_br", "iocfg_lb", "iocfg_lt", "iocfg_tm", "iocfg_tl";
	gpio-ranges = <&pio 0 0 250>;
	mediatek,eint = <&apirq>;
};
