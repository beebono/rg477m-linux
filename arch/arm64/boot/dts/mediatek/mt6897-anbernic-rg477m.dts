							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&little_core3_fan_low>;
					cooling-device = <&fan 1 1>;
				};
				map2 {
					trip = <&little_core3_fan_high>;
					cooling-device = <&fan 2 2>;
				};
			};
		};

		mid6-1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_MEDIUM_CPU6_0>;

			trips {
				medium_core6_1_passive: trip-passive {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				medium_core6_1_fan_low: trip-fan-low {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};
				medium_core6_1_fan_high: trip-fan-high {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "active";
				};
			};

			cooling-maps {
				map0 {
					trip = <&medium_core6_1_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&medium_core6_1_fan_low>;
					cooling-device = <&fan 1 1>;
				};
				map2 {
					trip = <&medium_core6_1_fan_high>;
					cooling-device = <&fan 2 2>;
				};
			};
		};

		mid6-2-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_MEDIUM_CPU6_1>;

			trips {
				medium_core6_2_passive: trip-passive {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				medium_core6_2_fan_low: trip-fan-low {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};
				medium_core6_2_fan_high: trip-fan-high {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "active";
				};
			};

			cooling-maps {
				map0 {
					trip = <&medium_core6_2_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&medium_core6_2_fan_low>;
					cooling-device = <&fan 1 1>;
				};
				map2 {
					trip = <&medium_core6_2_fan_high>;
					cooling-device = <&fan 2 2>;
				};
			};
		};

		dsu1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_DSU0>;

			trips {
				dsu1_passive: trip-passive {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				dsu1_fan_low: trip-fan-low {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};
				dsu1_fan_high: trip-fan-high {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "active";
				};
			};

			cooling-maps {
				map0 {
					trip = <&dsu1_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&dsu1_fan_low>;
					cooling-device = <&fan 1 1>;
