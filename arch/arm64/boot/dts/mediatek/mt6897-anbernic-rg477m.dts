		big7-2-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_BIG_CPU7_1>;

			trips {
				big_core7_2_passive: trip-passive {
