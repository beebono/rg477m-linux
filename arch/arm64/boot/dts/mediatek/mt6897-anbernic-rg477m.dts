					hysteresis = <5000>;
					type = "active";
				};
			};

			cooling-maps {
				map0 {
					trip = <&big_core7_2_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&big_core7_2_fan_low>;
					cooling-device = <&fan 1 1>;
				};
				map2 {
					trip = <&big_core7_2_fan_high>;
					cooling-device = <&fan 2 2>;
				};
			};
		};

		dsu3-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_DSU2>;

			trips {
				dsu3_passive: trip-passive {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				dsu3_fan_low: trip-fan-low {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};
				dsu3_fan_high: trip-fan-high {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "active";
				};
			};

			cooling-maps {
				map0 {
					trip = <&dsu3_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&dsu3_fan_low>;
					cooling-device = <&fan 1 1>;
				};
				map2 {
					trip = <&dsu3_fan_high>;
					cooling-device = <&fan 2 2>;
				};
			};
		};

		dsu4-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_DSU3>;

			trips {
				dsu4_passive: trip-passive {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
				dsu4_fan_low: trip-fan-low {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};
				dsu4_fan_high: trip-fan-high {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "active";
				};
			};

			cooling-maps {
				map0 {
					trip = <&dsu4_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&dsu4_fan_low>;
					cooling-device = <&fan 1 1>;
				};
				map2 {
					trip = <&dsu4_fan_high>;
					cooling-device = <&fan 2 2>;
				};
			};
		};

		/*
		 * Interim GPU protection: the GPU's own sensors sit inside its
		 * power domain and are not described yet, so the always-on SoC
		 * sensors drive the fan and throttle the GPU. They lag the GPU.
		 */
		soc-top1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_ap MT6897_AP_SOC_TOP0>;

			trips {
				soc_top1_fan_low: trip-fan-low {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};
				soc_top1_fan_high: trip-fan-high {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "active";
				};
				soc_top1_passive: trip-passive {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&soc_top1_passive>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&soc_top1_fan_low>;
					cooling-device = <&fan 1 1>;
				};
				map2 {
					trip = <&soc_top1_fan_high>;
					cooling-device = <&fan 2 2>;
				};
			};
		};

		/*
		 * Interim GPU protection: the GPU's own sensors sit inside its
		 * power domain and are not described yet, so the always-on SoC
		 * sensors drive the fan and throttle the GPU. They lag the GPU.
		 */
		soc-bot1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_ap MT6897_AP_SOC_BOT0>;

			trips {
				soc_bot1_fan_low: trip-fan-low {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};
				soc_bot1_fan_high: trip-fan-high {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "active";
				};
				soc_bot1_passive: trip-passive {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&soc_bot1_passive>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&soc_bot1_fan_low>;
					cooling-device = <&fan 1 1>;
				};
				map2 {
					trip = <&soc_bot1_fan_high>;
					cooling-device = <&fan 2 2>;
				};
			};
		};

		/*
		 * GPU sensor 0 (vendor TS9_0, zone gpu1). Only reads while
		 * the GPU is powered; while it is off the zone has no value and
		 * its trips do not change state. The SoC zones above keep their
		 * fan and GPU maps until these are proven on hardware.
		 */
		gpu0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_gpu MT6897_GPU0>;

			trips {
				gpu0_fan_low: trip-fan-low {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};
				gpu0_fan_high: trip-fan-high {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "active";
				};
				gpu0_passive: trip-passive {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&gpu0_passive>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&gpu0_fan_low>;
					cooling-device = <&fan 1 1>;
				};
				map2 {
					trip = <&gpu0_fan_high>;
					cooling-device = <&fan 2 2>;
				};
			};
		};

		/*
		 * GPU sensor 1 (vendor TS9_1, zone gpu2). Only reads while
		 * the GPU is powered; while it is off the zone has no value and
		 * its trips do not change state. The SoC zones above keep their
		 * fan and GPU maps until these are proven on hardware.
		 */
		gpu1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_gpu MT6897_GPU1>;

			trips {
				gpu1_fan_low: trip-fan-low {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};
				gpu1_fan_high: trip-fan-high {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "active";
				};
				gpu1_passive: trip-passive {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&gpu1_passive>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&gpu1_fan_low>;
					cooling-device = <&fan 1 1>;
				};
				map2 {
					trip = <&gpu1_fan_high>;
					cooling-device = <&fan 2 2>;
				};
			};
		};
	};
};

/*
 * SPM power domains (full MT6897 table). Registration reads each domain's
 * state and writes nothing: domains the bootloader left on are registered
 * always-on, the rest stay off until a consumer asks. Multimedia sub-block
 * clocks and the camera/ISP supplies are left out because their providers do
 * not exist here yet and would defer the whole controller.
 */
&soc {
	ifr_bus: syscon@1002c000 {
		compatible = "mediatek,mt6897-ifr_bus", "syscon";
		reg = <0x0 0x1002c000 0x0 0x1000>;
	};

	vlpcfg_bus: syscon@1c00c000 {
		compatible = "mediatek,mt6897-vlpcfg_bus", "syscon";
		reg = <0x0 0x1c00c000 0x0 0x1000>;
	};
};

&scpsys {
	infracfg = <&ifr_bus>;
	vlpcfg = <&vlpcfg_bus>;
	hw-voter-regmap = <&hwv>;
	clocks = <&topckgen CLK_TOP_AUD_INTBUS_SEL>,
		 <&topckgen CLK_TOP_ADSP_SEL>,
		 <&topckgen CLK_TOP_IMG1_SEL>,
		 <&topckgen CLK_TOP_IPE_SEL>,
		 <&topckgen CLK_TOP_VDEC_SEL>,
		 <&topckgen CLK_TOP_VENC_SEL>,
		 <&topckgen CLK_TOP_CAM_SEL>,
		 <&topckgen CLK_TOP_DPE_SEL>,
		 <&vlp_cksys CLK_VLP_CK_CCUSYS_SEL>,
		 <&topckgen CLK_TOP_CCU_AHB_SEL>,
		 <&topckgen CLK_TOP_MDP0_SEL>,
		 <&topckgen CLK_TOP_MDP1_SEL>,
		 <&topckgen CLK_TOP_DISP0_SEL>,
		 <&topckgen CLK_TOP_DISP1_SEL>,
		 <&topckgen CLK_TOP_OVL0_SEL>,
		 <&topckgen CLK_TOP_OVL1_SEL>,
		 <&topckgen CLK_TOP_MMINFRA_SEL>,
		 <&topckgen CLK_TOP_MMUP_SEL>;
	clock-names = "audio", "adsp_ao", "isp", "ipe", "vde", "ven",
		      "cam", "dpe", "ccu", "ccu_ahb", "mdp", "mdp1",
		      "disp", "disp1", "ovl", "ovl1", "mm_infra", "mmup";
	status = "okay";
};

/*
 * Cooling fan. PWM channel 0 on GPIO115 (already muxed by the bootloader),
 * supply switch on GPIO4. The vendor driver programs the high time as
 * (256 - level), i.e. the fan runs faster the longer the line is low, so the
 * levels below are inverted: 255 = stopped, 96 = vendor "cool" (160),
 * 1 = vendor "max" (255). Thresholds follow the vendor policy: 70 and 85 degC.
 */
/ {
	fan_vcc: regulator-fan-vcc {
		compatible = "regulator-fixed";
		regulator-name = "fan-vcc";
		gpio = <&pio 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	fan: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwm 0 40000>;
		fan-supply = <&fan_vcc>;
		cooling-levels = <255 96 1>;
		#cooling-cells = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_pins_default>;
	};
};

&pio {
	fan_pins_default: fan-default-pins {
		pins-pwm {
			pinmux = <0x7305>;
		};
	};
};

&pwm {
	clocks = <&pericfg CLK_PERAOP_PWM_HCLK>,
		 <&pericfg CLK_PERAOP_PWM_BCLK>,
		 <&pericfg CLK_PERAOP_PWM_FBCLK1>,
		 <&pericfg CLK_PERAOP_PWM_FBCLK2>,
		 <&pericfg CLK_PERAOP_PWM_FBCLK3>,
		 <&pericfg CLK_PERAOP_PWM_FBCLK4>;
	clock-names = "top", "main", "pwm1", "pwm2", "pwm3", "pwm4";
	/* The source selectors reset to 32 kHz; the fan needs 25 kHz PWM. */
	assigned-clocks = <&pericfg CLK_PERAOP_PWM_BSEL>,
			  <&pericfg CLK_PERAOP_PWM_FB1_SEL>;
	assigned-clock-parents = <&clk26m>, <&clk26m>;
	status = "okay";
};

/*
 * Backlight PWM. The bootloader leaves it running on GPIO131; the boot
 * framebuffer holds its clock so that it stays lit whoever else comes and goes.
 */
&pio {
	disp_pwm_pins_default: disp-pwm-default-pins {
		pins-pwm {
			pinmux = <0x8301>;
		};
	};
};

/ {
	/*
	 * No enable-gpios on purpose: the LED driver's enable is believed to
	 * share GPIO64 with the panel supply, which must not be switched yet.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&disp_pwm0 0 39385>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <51>;
	};
};

&disp_pwm0 {
	clocks = <&pericfg CLK_PERAOP_DISP_PWM0>,
		 <&topckgen CLK_TOP_DISP_PWM_SEL>;
	clock-names = "main", "mm";
	pinctrl-names = "default";
	pinctrl-0 = <&disp_pwm_pins_default>;
	status = "okay";
};

/*
 * Display: mediatek-drm on DSI0 (OVL0_2L in OVLSYS0 -> DISPSYS0 PQ bypass ->
 * DSI0 -> Truly FT8201P). Until the first modeset the bootloader's pipeline
 * keeps running and the console stays on simpledrm; mediatek-drm removes the
 * boot framebuffer when it binds. The panel supplies (GPIO63/GPIO64, PMIC
 * VFP) are deliberately not described: they must not be switched yet.
 */
&mipi_tx0 {
	status = "okay";
};

&disp_mutex0 {
	status = "okay";
};

&ovlsys0_mutex {
	status = "okay";
};

&ovl0_2l {
	status = "okay";
};

&dsi0 {
	status = "okay";

	panel@0 {
		compatible = "truly,ft8201p";
		reg = <0>;
		reset-gpios = <&pio 41 GPIO_ACTIVE_LOW>;
		backlight = <&backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out>;
			};
		};
	};

	port {
		dsi0_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};
};

/*
 * Touchscreen: the touch half of the FT8201P panel controller. It only answers
 * while the panel is powered and initialised. Supply (MT6368 VTP) is always on.
 */
&pio {
	touch_pins_default: touch-default-pins {
		pins-i2c {
			pinmux = <0xa301>, <0xa401>;
		};

		pins-irq {
			pinmux = <0x0900>;
			input-enable;
			bias-pull-up;
		};
	};
};

&i2c13 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&touch_pins_default>;
	status = "okay";

	touchscreen@38 {
		compatible = "focaltech,ft8201";
		reg = <0x38>;
		interrupts-extended = <&pio 9 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio 60 GPIO_ACTIVE_LOW>;
		touchscreen-size-x = <1280>;
		touchscreen-size-y = <960>;
	};
};

/*
 * GPU: Mali-G615 MC6 behind the GPUEB.
 *
 * The bootloader starts the GPUEB, which owns the GPU bucks (MT6368 VBUCK2,
 * MT6363 VSRAM_MDFE), MFG MTCMOS, MFGPLL/MFGSCPLL and DVFS. The AP only talks
 * to it over the mailbox; nothing here describes a regulator or a real clock.
 *
 * Stage A/B: gpueb_mbox and gpufreq probe passively; the IPI steps are run by
 * hand from /sys/kernel/debug/mt6897_gpu/.
 * Stage C: set the gpu node's status to "okay" (the one marked line below).
 */
&soc {
	gpueb_mbox: mailbox@13c2fd80 {
		compatible = "mediatek,mt6897-gpueb-mbox";
		reg = <0x0 0x13c2fd80 0x0 0x280>,
		      <0x0 0x13c62000 0x0 0x7c>;
		reg-names = "data", "ctl";
		interrupts = <GIC_SPI 588 IRQ_TYPE_LEVEL_HIGH 0>;
		#mbox-cells = <1>;
	};

	gpufreq: power-controller@13c2fd1c {
		compatible = "mediatek,mt6897-gpufreq";
		reg = <0x0 0x13c2fd1c 0x0 0x64>,
		      <0x0 0x13f91000 0x0 0x1000>,
		      <0x0 0x1c001fc0 0x0 0x8>,
		      <0x0 0x13c620a8 0x0 0x4>,
		      <0x0 0x13000000 0x0 0x1000>,
		      <0x0 0x13fa000c 0x0 0x4>,
		      <0x0 0x13fa0c0c 0x0 0x4>,
		      <0x0 0x100001f0 0x0 0x4>;
		/* the last three are read only, for frequency readback */
		reg-names = "gpr", "rpc", "spm-status", "pdca-sta", "gpu",
			    "mfgpll-con1", "mfgscpll-con1", "topck-mfg-sel";
		memory-region = <&gpueb_gpufreq_mem>;
		mboxes = <&gpueb_mbox 0>, <&gpueb_mbox 1>, <&gpueb_mbox 2>,
			 <&gpueb_mbox 3>, <&gpueb_mbox 4>, <&gpueb_mbox 5>,
			 <&gpueb_mbox 6>, <&gpueb_mbox 7>, <&gpueb_mbox 8>,
			 <&gpueb_mbox 9>, <&gpueb_mbox 10>;
		mbox-names = "fast-dvfs-event", "gpufreq", "sleep", "timer",
			     "fhctl", "ccf", "gpumpu", "fast-dvfs",
			     "ipir-c-met", "ipis-c-met", "brisket";
		#clock-cells = <0>;
		#power-domain-cells = <0>;
	};

	gpu: gpu@13000000 {
		#cooling-cells = <2>;	/* panthor devfreq cooling */
		compatible = "mediatek,mt6897-mali", "arm,mali-valhall-csf";
		reg = <0x0 0x13000000 0x0 0x480000>;
		interrupts = <GIC_SPI 586 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 585 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 584 IRQ_TYPE_LEVEL_HIGH 0>;
		interrupt-names = "job", "mmu", "gpu";
		/* read-only view of the EB's frequency; gates nothing */
		clocks = <&gpufreq>;
		clock-names = "core";
		power-domains = <&gpufreq>;
		status = "okay";
	};
};
