					cooling-device = <&fan 2 2>;
				};
			};
		};

		lit3-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT6897_MCU_LITTLE_CPU3>;

			trips {
