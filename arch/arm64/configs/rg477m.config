# Anbernic RG477M (MT6897) additions on top of defconfig + xaga.config:
#   make ARCH=arm64 LLVM=-18 O=... defconfig xaga.config rg477m.config
CONFIG_ARM64_EMBEDDED_DTB="mediatek/mt6897-anbernic-rg477m"
# The kernel log is read back through ramoops after the device falls back to slot A.
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# Reboot shortly after a panic so the A/B retry counter moves on.
CONFIG_PANIC_TIMEOUT=5
# The bootloader appends a bootconfig block to the initramfs. Without this option the kernel does
# not strip it and the initramfs fails to unpack ("Decoding failed").
CONFIG_BOOT_CONFIG=y

# Stage 1: vendor stacks from the xaga/TB375FC tree that run code at init without a device-tree
# node, or whose hardware is not described yet. The connectivity core alone blocks the boot for
# 30 s waiting for a firmware handshake. Re-enable one at a time as their nodes are added.
# CONFIG_MTK_COMBO is not set
# CONFIG_MTK_BTIF is not set
# CONFIG_MTK_GPUEB is not set
# CONFIG_MTK_GPUEB_MBOX is not set
# CONFIG_DRM_PANTHOR is not set
# CONFIG_DRM_MEDIATEK_V2 is not set
# CONFIG_DRM_MEDIATEK is not set
# CONFIG_MTK_MML is not set
# CONFIG_MTK_CMDQ_MBOX_EXT is not set
# CONFIG_COMMON_CLK_MT6897_MFGCFG is not set
# CONFIG_MTK_SCPSYS_MT6897_GPUSYS is not set
# CONFIG_MTK_MFG_PM_DOMAIN is not set
# CONFIG_MTK_DRAMC is not set
# CONFIG_MTK6895_DVFSRC_PIN is not set
# CONFIG_SND_SOC_TFA98XX is not set
# CONFIG_SND_SOC_TFA9874 is not set
# CONFIG_INPUT_AW8697 is not set
# CONFIG_TOUCHSCREEN_NVT_TS_SPI is not set
# Xiaomi "xaga" panel and backlight drivers (need the vendor display stack) and MT6895 audio
# (selects the TFA98xx amplifier, which logs at init without a node).
# CONFIG_DRM_PANEL_L16_36_02_0B_DSC_VDO is not set
# CONFIG_DRM_PANEL_LEDS_KTZ8863A is not set
# CONFIG_SND_SOC_MT6895_MT6368 is not set
# CONFIG_SND_SOC_MT6895 is not set

# Stage 2: USB device mode with a CDC ACM serial gadget bound at boot
CONFIG_PHY_MTK_XSPHY=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
CONFIG_USB_G_SERIAL=y
CONFIG_SYSCON_REBOOT_MODE=y

# Stage 3: pin controller
CONFIG_PINCTRL_MT6897=y

# Stage 4: MT6897 clock controllers
CONFIG_COMMON_CLK_MT6897=y
CONFIG_COMMON_CLK_MT6897_BUS=y
CONFIG_COMMON_CLK_MT6897_PERI=y
CONFIG_COMMON_CLK_MT6897_VLP=y

# Stage 5: board input
CONFIG_INPUT_JOYSTICK=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_JOYSTICK_SPI_MCU_JOYPAD=y
CONFIG_INPUT_JOYDEV=y

# Stage 6: thermal sensors and power domains
CONFIG_MTK_THERMAL=y
CONFIG_MTK_LVTS_THERMAL=y
CONFIG_MTK_LVTS_THERMAL_DEBUGFS=y
CONFIG_MTK_SCPSYS_MT6897=y
