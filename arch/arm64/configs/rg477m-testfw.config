# Optional, on top of rg477m.config: build the Mali CSF firmware into the kernel
# for tests that run from an initramfs with no root filesystem. Copy Arm's
# arm/mali/arch11.8/mali_csffw.bin (linux-firmware) to
# firmware/arm/mali/arch11.8/ in the source tree first; it is not in this
# repository.
CONFIG_EXTRA_FIRMWARE="arm/mali/arch11.8/mali_csffw.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
